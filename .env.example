# Copy to backend/.env for local use. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./recycleproof.db
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_EXPIRY_MINUTES=720
DEMO_SESSION_TTL_MINUTES=120
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=15
LOCAL_UPLOAD_DIR=./uploads
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Local only. Disabled by default; dev code is only included in OTP responses in non-production mode.
DEV_OTP_ENABLED=false

# Gmail SMTP: enable 2-Step Verification then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_USE_TLS=true

# Local development uses STORAGE_PROVIDER=local. For AWS set STORAGE_PROVIDER=s3.
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
S3_BUCKET=your-private-recycleproof-bucket
# Prefer IAM role/standard credential chain. For local machine use AWS CLI profile or environment credentials;
# do not put AWS access keys in frontend files or commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Frontend Vite proxy/API target (not a secret)
VITE_API_BASE_URL=http://localhost:8000
